    client --> api
    api --> create
    api --> read
    create --> ddb
    create -- OrderReceived --> bus
    read -- eventos de teste --> bus
    bus -- OrderReceived --> process
    bus -- TransactionStatusChanged --> tx
    bus -- SalesReportRequested --> report
    sched -- cron --> report
    bus -- eventos operacionais --> notify
    process --> ddb
    tx --> ddb
    report --> ddb
    report --> s3
    notify --> sns
    process -. falhas .-> sqs
    sqs -. alarme .-> cw
    cw -. ALARM .-> sns
