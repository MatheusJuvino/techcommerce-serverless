# Exemplo de variáveis de ambiente — NÃO coloque credenciais reais neste arquivo.
# Na AWS, as funções recebem estas variáveis pelo template SAM (Globals.Function.Environment)
# e se autenticam pela role IAM de execução. Localmente, o simulador define tudo sozinho.

# Ambiente: local (simulação) | dev | prod
APP_ENV=local
AWS_REGION=sa-east-1
LOG_LEVEL=INFO

# Recursos (na AWS são preenchidos automaticamente pelo template)
ORDERS_TABLE=techcommerce-local-orders
IDEMPOTENCY_TABLE=techcommerce-local-idempotency
AUTOMATION_LOG_TABLE=techcommerce-local-automation-log
EVENT_BUS_NAME=techcommerce-local-bus
NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:sa-east-1:123456789012:techcommerce-local-operational-notifications
REPORTS_BUCKET=techcommerce-local-reports

# Regras de negócio
MAX_ORDER_VALUE=10000
MAX_ITEM_QUANTITY=50
# true habilita o SKU-FALHA-TEMPORARIA (demonstração de retentativas/DLQ)
ENABLE_FAULT_INJECTION=true
ALLOWED_ORIGIN=*
IDEMPOTENCY_TTL_SECONDS=86400
AUTOMATION_LOG_TTL_DAYS=30

# Demonstração local
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8000
LOCAL_SCHEDULE_INTERVAL_SECONDS=120

# Testes de integração contra a AWS (após o deploy)
# TECHCOMMERCE_API_URL=https://xxxx.execute-api.sa-east-1.amazonaws.com/dev

# Credenciais AWS: use `aws configure` / AWS SSO (perfil em ~/.aws), nunca este arquivo.
# AWS_PROFILE=meu-perfil
